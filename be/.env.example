# Cấu hình local minh họa, thay placeholder bằng secret riêng và không đưa tệp .env thật vào Git
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL="postgresql://user:password@localhost:5432/kpi_db?schema=public"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=seminar-api
JWT_AUDIENCE=seminar-web
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
BCRYPT_COST=12
# Mật khẩu demo đã thống nhất, VC02/VC04 sẽ áp dụng policy và cấp tài khoản từ cấu hình này
INITIAL_ACCOUNT_PASSWORD=123456
# Các cờ chỉ validate cấu hình, không đồng nghĩa provider đã được triển khai hoặc gửi thành công
CREDENTIAL_DELIVERY_ENABLED=false
CREDENTIAL_DELIVERY_TTL_HOURS=24
ONBOARDING_TOKEN_TTL_MINUTES=15
# Khi bật gửi credential cần khóa base64 của đúng 32 byte cùng mã khóa để mã hóa dữ liệu tạm
# CREDENTIALS_ENCRYPTION_KEY= # Điền khóa base64 của 32 byte khi bật gửi credential
# CREDENTIALS_ENCRYPTION_KEY_ID=local-v1 # Mã khóa để nhận diện phiên bản mã hóa
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_ROWS=100
IMPORT_SESSION_TTL_MINUTES=30
EMAIL_ENABLED=false
EMAIL_DRY_RUN=true
SMTP_PORT=587
SMTP_SECURE=false
# Khi EMAIL_ENABLED=true cần SMTP_HOST, SMTP_USER, SMTP_PASSWORD và MAIL_FROM
WEB_PUSH_ENABLED=false
# Khi WEB_PUSH_ENABLED=true cần WEB_PUSH_VAPID_PUBLIC_KEY, WEB_PUSH_VAPID_PRIVATE_KEY và WEB_PUSH_SUBJECT
# ZNS là tùy chọn có phí, demo chỉ chuẩn bị cấu hình và giữ cờ tắt, không yêu cầu gửi tin thật
# Chỉ bật khi doanh nghiệp yêu cầu sử dụng và cung cấp tài khoản cùng cấu hình hợp lệ
ZALO_ZNS_ENABLED=false
# Khi bật Zalo cần ZALO_APP_ID, ZALO_APP_SECRET, ZALO_OA_ID và ZALO_ZNS_TEMPLATE_MAP JSON ánh xạ sự kiện
STORAGE_PROVIDER=none
# Khi chọn supabase cần SUPABASE_URL HTTPS và SUPABASE_KEY, không dùng khóa này ở frontend
STORAGE_SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_FILES_PER_CRITERION=10
REMINDER_LEAD_HOURS=24
ENABLE_DEMO_TOOLS=false
SEED_DEMO_DATA=false
# Seed chỉ chạy trên DB được chỉ định, file credential phải được giữ riêng và xóa sau khi sử dụng
SEED_CREDENTIALS_FILE=.seed-credentials.json
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEED
# Chỉ xuất OpenAPI khi chỉ định đường dẫn, tránh tự ghi đè tài liệu đang được người dùng sửa
# OPENAPI_OUTPUT_FILE=docs/openapi.generated.json # Đích xuất tài liệu khi có yêu cầu
