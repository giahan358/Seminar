  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Dán accessToken nhận được từ POST /api/v1/auth/login (không cần gõ chữ Bearer)."
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin",
            "description": "Tên đăng nhập"
          },
          "password": {
            "type": "string",
            "example": "your-password",
            "description": "Mật khẩu"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "dán-refreshToken-nhận-được-khi-đăng-nhập",
            "description": "Refresh token nhận được khi đăng nhập"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "current-password",
            "description": "Mật khẩu hiện tại"
          },
          "newPassword": {
