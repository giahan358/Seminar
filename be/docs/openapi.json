                    "timestamp": "2026-11-03T00:00:00.000Z",
                    "database": "up"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Cơ sở dữ liệu không khả dụng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Kiểm tra trạng thái API và cơ sở dữ liệu",
        "tags": [
          "Health"
        ]
      }
    },
